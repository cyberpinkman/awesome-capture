{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-capture.local/contracts/artifact-transcript-v2.schema.json",
  "title": "Awesome Capture transcript artifact v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "status",
    "created_at",
    "source",
    "transcription",
    "segments",
    "text",
    "no_speech_detected",
    "outputs",
    "warnings",
    "producer"
  ],
  "properties": {
    "schema_version": {"const": "awesome-capture.artifact/v2"},
    "artifact_type": {"const": "transcript"},
    "status": {"const": "complete"},
    "created_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "snapshot_path",
        "sha256",
        "bytes",
        "duration_ms",
        "has_audio",
        "has_video",
        "upstream",
        "sidecar"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/absolute_path"},
        "snapshot_path": {"$ref": "#/$defs/absolute_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "duration_ms": {"type": "integer", "minimum": 1},
        "has_audio": {"const": true},
        "has_video": {"type": "boolean"},
        "upstream": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact_path",
                "artifact_sha256",
                "platform",
                "fingerprint"
              ],
              "properties": {
                "artifact_path": {"$ref": "#/$defs/absolute_path"},
                "artifact_sha256": {"$ref": "#/$defs/sha256"},
                "platform": {
                  "enum": ["douyin", "tiktok", "bilibili", "youtube", "twitter"]
                },
                "fingerprint": {"$ref": "#/$defs/sha256"}
              }
            }
          ]
        },
        "sidecar": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "bytes"],
              "properties": {
                "path": {"$ref": "#/$defs/absolute_path"},
                "sha256": {"$ref": "#/$defs/sha256"},
                "bytes": {"type": "integer", "minimum": 1}
              }
            }
          ]
        }
      }
    },
    "transcription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "settings_sha256",
        "algorithm",
        "execution_guard_sha256",
        "engine",
        "engine_identity",
        "requested_language",
        "detected_language",
        "chunk_seconds",
        "whisper_cpp_cpu_only",
        "chunk_set",
        "devices_used",
        "gpu_fallback_count"
      ],
      "properties": {
        "job_id": {"$ref": "#/$defs/sha256"},
        "settings_sha256": {"$ref": "#/$defs/sha256"},
        "algorithm": {"$ref": "#/$defs/algorithm_identity"},
        "execution_guard_sha256": {"$ref": "#/$defs/sha256"},
        "engine": {
          "enum": [
            "sidecar-subtitle",
            "whisper-cpp",
            "faster-whisper",
            "mlx-whisper",
            "external"
          ]
        },
        "engine_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity_sha256",
            "model",
            "executable",
            "adapter",
            "packages"
          ],
          "properties": {
            "identity_sha256": {"$ref": "#/$defs/sha256"},
            "model": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/content_identity"}]},
            "executable": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/content_identity"}]},
            "adapter": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/content_identity"}]},
            "packages": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "version"],
                "properties": {
                  "name": {"type": "string", "minLength": 1, "maxLength": 128},
                  "version": {"type": "string", "minLength": 1, "maxLength": 256}
                }
              }
            }
          }
        },
        "requested_language": {
          "type": ["string", "null"],
          "maxLength": 64
        },
        "detected_language": {
          "type": ["string", "null"],
          "maxLength": 64
        },
        "chunk_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "whisper_cpp_cpu_only": {"type": "boolean"},
        "chunk_set": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["manifest_path", "manifest_sha256", "count", "timeline"],
              "properties": {
                "manifest_path": {"$ref": "#/$defs/absolute_path"},
                "manifest_sha256": {"$ref": "#/$defs/sha256"},
                "count": {"type": "integer", "minimum": 1},
                "timeline": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100000,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["index", "offset_ms", "duration_ms", "bytes", "sha256"],
                    "properties": {
                      "index": {"type": "integer", "minimum": 0},
                      "offset_ms": {"type": "integer", "minimum": 0},
                      "duration_ms": {"type": "integer", "minimum": 1},
                      "bytes": {"type": "integer", "minimum": 1},
                      "sha256": {"$ref": "#/$defs/sha256"}
                    }
                  }
                }
              }
            }
          ]
        },
        "devices_used": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 64}
        },
        "gpu_fallback_count": {"type": "integer", "minimum": 0}
      }
    },
    "segments": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_ms", "end_ms", "text", "chunk_index"],
        "properties": {
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 1},
          "text": {"type": "string", "minLength": 1, "maxLength": 100000},
          "chunk_index": {"type": "integer", "minimum": 0},
          "avg_logprob": {
            "type": ["number", "null"],
            "minimum": -1000,
            "maximum": 0
          }
        }
      }
    },
    "text": {"type": "string", "maxLength": 67108864},
    "no_speech_detected": {"type": "boolean"},
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markdown", "text", "srt", "vtt", "state", "chunk_manifest"],
      "properties": {
        "markdown": {"$ref": "#/$defs/file_descriptor"},
        "text": {"$ref": "#/$defs/file_descriptor"},
        "srt": {"$ref": "#/$defs/file_descriptor"},
        "vtt": {"$ref": "#/$defs/file_descriptor"},
        "state": {"$ref": "#/$defs/file_descriptor"},
        "chunk_manifest": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/file_descriptor"}
          ]
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 1000,
      "items": {"type": "string", "maxLength": 4000}
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "contract_digest"],
      "properties": {
        "skill": {"const": "transcribe-media"},
        "contract_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "absolute_path": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "algorithm_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {
          "const": "awesome-capture.transcription-algorithm/v1"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "content_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "bytes"],
      "properties": {
        "kind": {"enum": ["file", "directory"]},
        "path": {"$ref": "#/$defs/absolute_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "file_count": {"type": "integer", "minimum": 1},
        "version": {"type": ["string", "null"], "maxLength": 512}
      }
    },
    "file_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/absolute_path"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
