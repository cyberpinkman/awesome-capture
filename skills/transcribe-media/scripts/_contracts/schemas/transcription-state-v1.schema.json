{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-capture.local/contracts/transcription-state-v1.schema.json",
  "title": "Awesome Capture transcription state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "job_id",
    "settings_sha256",
    "execution_guard_sha256",
    "settings",
    "chunk_set",
    "chunks"
  ],
  "properties": {
    "schema_version": {"const": "awesome-capture.transcription-state/v1"},
    "status": {"enum": ["running", "ready_to_publish", "complete"]},
    "job_id": {"$ref": "#/$defs/sha256"},
    "settings_sha256": {"$ref": "#/$defs/sha256"},
    "execution_guard_sha256": {"$ref": "#/$defs/sha256"},
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_digest",
        "algorithm",
        "source_path",
        "source_sha256",
        "source_bytes",
        "upstream_artifact_sha256",
        "engine",
        "engine_identity",
        "requested_language",
        "chunk_seconds",
        "whisper_cpp_cpu_only",
        "sidecar_sha256"
      ],
      "properties": {
        "contract_digest": {"$ref": "#/$defs/sha256"},
        "algorithm": {"$ref": "#/$defs/algorithm_identity"},
        "source_path": {"$ref": "#/$defs/absolute_path"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_bytes": {"type": "integer", "minimum": 1},
        "upstream_artifact_sha256": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        },
        "engine": {
          "enum": [
            "sidecar-subtitle",
            "whisper-cpp",
            "faster-whisper",
            "mlx-whisper",
            "external"
          ]
        },
        "engine_identity": {"$ref": "#/$defs/engine_identity"},
        "requested_language": {"type": ["string", "null"], "maxLength": 64},
        "chunk_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "whisper_cpp_cpu_only": {"type": "boolean"},
        "sidecar_sha256": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        }
      }
    },
    "chunk_set": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest_path", "manifest_sha256", "count", "timeline"],
          "properties": {
            "manifest_path": {"$ref": "#/$defs/absolute_path"},
            "manifest_sha256": {"$ref": "#/$defs/sha256"},
            "count": {"type": "integer", "minimum": 1},
            "timeline": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["index", "offset_ms", "duration_ms", "bytes", "sha256"],
                "properties": {
                  "index": {"type": "integer", "minimum": 0},
                  "offset_ms": {"type": "integer", "minimum": 0},
                  "duration_ms": {"type": "integer", "minimum": 1},
                  "bytes": {"type": "integer", "minimum": 1},
                  "sha256": {"$ref": "#/$defs/sha256"}
                }
              }
            }
          }
        }
      ]
    },
    "chunks": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(?:sidecar|chunk-[0-9]{5,}\\.wav)$": {"$ref": "#/$defs/chunk_state"}
      },
      "maxProperties": 100000
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "absolute_path": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "algorithm_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {
          "const": "awesome-capture.transcription-algorithm/v1"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "content_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "bytes"],
      "properties": {
        "kind": {"enum": ["file", "directory"]},
        "path": {"$ref": "#/$defs/absolute_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "file_count": {"type": "integer", "minimum": 1},
        "version": {"type": ["string", "null"], "maxLength": 512}
      }
    },
    "engine_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_sha256", "model", "executable", "adapter", "packages"],
      "properties": {
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "model": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/content_identity"}]},
        "executable": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/content_identity"}]},
        "adapter": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/content_identity"}]},
        "packages": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 128},
              "version": {"type": "string", "minLength": 1, "maxLength": 256}
            }
          }
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms", "text", "chunk_index"],
      "properties": {
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1, "maxLength": 100000},
        "chunk_index": {"type": "integer", "minimum": 0},
        "avg_logprob": {
          "type": ["number", "null"],
          "minimum": -1000,
          "maximum": 0
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "gpu_attempted",
        "gpu_fallback",
        "gpu_failure",
        "gpu_disabled_after_failure"
      ],
      "properties": {
        "device": {"type": "string", "minLength": 1, "maxLength": 64},
        "gpu_attempted": {"type": "boolean"},
        "gpu_fallback": {"type": "boolean"},
        "gpu_failure": {"type": ["string", "null"], "maxLength": 4000},
        "gpu_disabled_after_failure": {"type": "boolean"}
      }
    },
    "chunk_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "language",
        "silent",
        "chunk_sha256",
        "offset_ms",
        "duration_ms",
        "raw_output_sha256",
        "runtime",
        "segments"
      ],
      "properties": {
        "status": {"const": "complete"},
        "language": {"type": ["string", "null"], "maxLength": 64},
        "silent": {"type": "boolean"},
        "chunk_sha256": {"$ref": "#/$defs/sha256"},
        "offset_ms": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 1},
        "raw_output_sha256": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        },
        "runtime": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/runtime"}]
        },
        "segments": {
          "type": "array",
          "maxItems": 1000000,
          "items": {"$ref": "#/$defs/segment"}
        }
      }
    }
  }
}
